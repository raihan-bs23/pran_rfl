<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="agent_retailer_conversation_wizard" model="ir.ui.view">
        <field name="name">agent.retailer.conversation.wizard</field>
        <field name="model">conversation.wizard</field>
        <field name="arch" type="xml">
            <form string="AgentxRetailer Conversation">
                <sheet>
                    <field name="conversation" readonly="1"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
