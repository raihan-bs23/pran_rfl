<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="bs_inherit_sale_order_form" model="ir.ui.view">
            <field name="name">bs.inherit.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="tag_ids" position="after">
                    <field name="call_id" readonly="1"/>
                    <field name="conversation" invisible="1"/>
                </field>
                <xpath expr="//header" position="inside">
                    <button name="fetch_call_info" string="Fetch Call" invisible="not call_id"
                            type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                        <button name="view_conversation" string="View Conversation"
                                invisible="not conversation"
                                type="object" class="oe_stat_button" icon="fa-eye"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>