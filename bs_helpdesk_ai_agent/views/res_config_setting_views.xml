<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_verbex" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.verbex</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='integration']" position="after">
                    <block title="Verbex Integration" name="verbex_integration">
                        <setting id="verbex_api_base_url" help="Verbex API Base URL">
                            <field name="verbex_api_base_url"/>
                        </setting>
                        <setting id="verbex_api_key" help="Verbex API Key">
                            <field name="verbex_api_key" password="True"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>