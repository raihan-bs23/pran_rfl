<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="bs_inherit_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">bs.inherit.helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="fetch_call_info" string="Fetch Call" invisible="not call_id"
                        type="object" class="oe_highlight"/>
            </xpath>

            <field name="partner_id" position="after">
                <field name="partner_name" string="Customer Name"/>
                <field name="call_id" readonly="1"/>
            </field>

            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <div class="oe_title">
                    <div class="o_row">
                        <div style="min-width: 100%;">
                            <label for="name" string="Title"/>
                            <h1>
                                <field name="name" placeholder="e.g. Vision AC not Working"/>
                            </h1>
                        </div>
                        <div style="min-width: 20%;">
                            <label for="reference"/>
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="view_conversation" string="View Conversation"
                            invisible="not conversation"
                            type="object" class="oe_stat_button" icon="fa-eye"/>
            </xpath>
        </field>
    </record>

    <record id="bs_inherit_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">bs.inherit.helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban"/>
        <field name="arch" type="xml">
            <field name="commercial_partner_id" position="before">
                <field name="reference"/>
            </field>
        </field>
    </record>

    <record id="bs_inherit_helpdesk_ticket_tree" model="ir.ui.view">
        <field name="name">bs.inherit.helpdesk.ticket.tree</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
        <field name="arch" type="xml">
            <field name="ticket_ref" position="after">
                <field name="reference"/>
            </field>
        </field>
    </record>

</odoo>
